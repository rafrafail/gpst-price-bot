[Unit]
Description=GPST price market collection (runs where sources are reachable)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# no User= in user units (runs as owner); User= breaks GROUP step
WorkingDirectory=/home/rafail/trest_working_dir/price_bot
# secret value is not inlined: read COLLECT_PROXY from the profile env file
EnvironmentFile=/home/rafail/.hermes/profiles/trest/.env.collect
Environment=PRICE_DATABASE_PATH=/home/rafail/trest_working_dir/price_bot/data/prices.sqlite3
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
ExecStart=/home/rafail/.hermes/hermes-agent/venv/bin/python -m features.prices.collector.collect --triggered-by=timer
ExecStartPost=/usr/bin/rsync -az /home/rafail/trest_working_dir/price_bot/data/prices.sqlite3 tt-prod:/tmp/gpst_collected.sqlite3
ExecStartPost=/usr/bin/ssh tt-prod /home/user/projects/gpst_price_bot/scripts/absorb_wrapper.sh
TimeoutStartSec=1800

# Telegram Bot Token
BOT_TOKEN=xxx:telegram-bot-token

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-...

# Admin IDs (comma-separated)
ADMIN_IDS=12345,67890

# Debug Mode (1 = enabled, 0 = disabled)
DEBUG_MODE=1

# Log to File (1 = enabled, 0 = disabled)
LOG_TO_FILE=1

# Database Path (optional, defaults to bot.db)
# DATABASE_PATH=bot.db
